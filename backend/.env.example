# ===================== Server =====================
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/servoshakti
JWT_SECRET=change-me
# First admin created by `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===================== Business rules =====================
ACCEPTANCE_WINDOW_MINUTES=10

# ===================== File uploads =====================
UPLOAD_PATH=uploads/
# Cloudinary (optional: Admin -> Developer Settings can switch uploads from local disk to Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===================== Login OTP (SMS India Hub, DLT) =====================
# true = every OTP is 1234 and no SMS is sent (development only). MUST be false in production.
# The same switch controls the customer closure OTP an engineer asks for at the end of a job.
USE_DEFAULT_OTP=true
SMS_INDIA_HUB_USERNAME=
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
OTP_EXPIRY_MINUTES=10
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=600

# ===================== Push notifications (Firebase Cloud Messaging) =====================
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Paste the whole JSON on ONE line. Without it the app still works; pushes are simply skipped.
FIREBASE_SERVICE_ACCOUNT=

# ===================== Maps / zones =====================
# The browser key lives in frontend/.env (VITE_GOOGLE_MAPS_API_KEY). This server-side key is for geocoding / distance calls.
GOOGLE_MAPS_API_KEY=

# ===================== Phase 1B: AI complaint assistant (provider to be selected) =====================
# Leave blank until a provider is chosen; complaints then stay in the manual/operator flow.
AI_CALL_PROVIDER=
AI_CALL_API_KEY=
AI_CALL_API_SECRET=
AI_CALL_FROM_NUMBER=
AI_CALL_WEBHOOK_SECRET=
SPEECH_TO_TEXT_API_KEY=
ANTHROPIC_API_KEY=

# ===================== Payments / payouts (optional) =====================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
PAYMENT_WEBHOOK_SECRET=

# ===================== Mobile recharge for engineers (provider to be selected) =====================
RECHARGE_API_PROVIDER=
RECHARGE_API_KEY=
